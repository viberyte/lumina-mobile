import React, { useState, useEffect, useRef } from 'react';
import {
  View,
  Text,
  StyleSheet,
  ScrollView,
  TouchableOpacity,
  TextInput,
  ActivityIndicator,
  Alert,
  Modal,
  RefreshControl,
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { Ionicons } from '@expo/vector-icons';
import { useRouter } from 'expo-router';
import AsyncStorage from '@react-native-async-storage/async-storage';
import Animated, { FadeInDown, FadeIn } from 'react-native-reanimated';
import * as ImagePicker from 'expo-image-picker';
import * as Haptics from 'expo-haptics';
import { Swipeable, GestureHandlerRootView } from 'react-native-gesture-handler';

const API_BASE = 'https://viberyte.com';

type MenuItem = {
  id: number;
  item_name: string;
  price: number;
  category: string;
  description?: string;
};

const CATEGORY_META: Record<string, { label: string; icon: string; order: number }> = {
  appetizers:     { label: 'Appetizers',    icon: 'flame-outline',        order: 0 },
  entrees:        { label: 'Entrées',       icon: 'restaurant-outline',   order: 1 },
  'main course':  { label: 'Main Course',   icon: 'restaurant-outline',   order: 2 },
  'main courses': { label: 'Main Courses',  icon: 'restaurant-outline',   order: 3 },
  tortillas:      { label: 'Tortillas',     icon: 'pizza-outline',        order: 4 },
  sides:          { label: 'Sides',         icon: 'leaf-outline',         order: 5 },
  desserts:       { label: 'Desserts',      icon: 'ice-cream-outline',    order: 6 },
  cocktails:      { label: 'Cocktails',     icon: 'wine-outline',         order: 7 },
  wine:           { label: 'Wine',          icon: 'wine-outline',         order: 8 },
  beer:           { label: 'Beer',          icon: 'beer-outline',         order: 9 },
  bottles:        { label: 'Bottles',       icon: 'flask-outline',        order: 10 },
  hookah:         { label: 'Hookah',        icon: 'cloud-outline',        order: 11 },
  other:          { label: 'Other',         icon: 'ellipsis-horizontal',  order: 99 },
};

const ADD_CATEGORIES = [
  'Appetizers', 'Entrees', 'Cocktails', 'Wine', 'Beer', 'Bottles',
  'Desserts', 'Sides', 'Hookah', 'Other',
];

const getToken = async () => {
  const session = await AsyncStorage.getItem('lumina_partner_session');
  if (!session) return null;
  return JSON.parse(session).token;
};

const groupByCategory = (items: MenuItem[]) => {
  const groups: Record<string, MenuItem[]> = {};
  items.forEach(item => {
    const cat = (item.category || 'other').toLowerCase();
    if (!groups[cat]) groups[cat] = [];
    groups[cat].push(item);
  });

  return Object.entries(groups)
    .map(([key, items]) => {
      const meta = CATEGORY_META[key] || { label: key.charAt(0).toUpperCase() + key.slice(1), icon: 'ellipsis-horizontal', order: 50 };
      return { key, label: meta.label, icon: meta.icon, order: meta.order, items };
    })
    .sort((a, b) => a.order - b.order);
};

function MenuItemRow({ item, onDelete, onEdit }: { item: MenuItem; onDelete: (id: number) => void; onEdit: (item: MenuItem) => void }) {
  const swipeRef = useRef<Swipeable>(null);

  const renderRightActions = () => (
    <TouchableOpacity
      style={styles.deleteAction}
      onPress={() => {
        Haptics.notificationAsync(Haptics.NotificationFeedbackType.Warning);
        Alert.alert('Remove Item', `Remove "${item.item_name}" from your menu?`, [
          { text: 'Cancel', style: 'cancel', onPress: () => swipeRef.current?.close() },
          { text: 'Remove', style: 'destructive', onPress: () => onDelete(item.id) },
        ]);
      }}
    >
      <Ionicons name="trash-outline" size={20} color="#fff" />
    </TouchableOpacity>
  );

  return (
    <Swipeable ref={swipeRef} renderRightActions={renderRightActions} overshootRight={false}>
      <TouchableOpacity style={styles.itemRow} onPress={() => onEdit(item)} activeOpacity={0.6}>
        <View style={styles.itemInfo}>
          <Text style={styles.itemName} numberOfLines={1}>{item.item_name}</Text>
          {item.description ? (
            <Text style={styles.itemDesc} numberOfLines={1}>{item.description}</Text>
          ) : null}
        </View>
        <View style={styles.itemRight}>
          {item.price > 0 && (
            <Text style={styles.itemPrice}>${item.price % 1 === 0 ? item.price.toFixed(0) : item.price.toFixed(2)}</Text>
          )}
          <Ionicons name="chevron-forward" size={14} color="#3f3f46" />
        </View>
      </TouchableOpacity>
    </Swipeable>
  );
}

export default function MenuManager() {
  const router = useRouter();
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [items, setItems] = useState<MenuItem[]>([]);
  const [venueName, setVenueName] = useState('');
  const [scanning, setScanning] = useState(false);
  const [scanProgress, setScanProgress] = useState('');

  // Add/Edit modal
  const [modalVisible, setModalVisible] = useState(false);
  const [editingItem, setEditingItem] = useState<MenuItem | null>(null);
  const [itemName, setItemName] = useState('');
  const [itemPrice, setItemPrice] = useState('');
  const [itemCategory, setItemCategory] = useState('Cocktails');
  const [saving, setSaving] = useState(false);

  // Filter
  const [activeFilter, setActiveFilter] = useState('all');

  useEffect(() => {
    loadMenu();
  }, []);

  const loadMenu = async () => {
    try {
      const token = await getToken();
      if (!token) { router.replace('/partner'); return; }

      const meRes = await fetch(`${API_BASE}/api/partner/auth/me`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (meRes.ok) {
        const meData = await meRes.json();
        if (meData.venues?.length > 0) {
          const home = meData.venues.find((v: any) => v.is_home) || meData.venues[0];
          setVenueName(home.name || meData.partner?.business_name || '');
        } else {
          setVenueName(meData.partner?.business_name || '');
        }
      }

      const res = await fetch(`${API_BASE}/api/partner/save-menu`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (res.ok) {
        const data = await res.json();
        setItems(data.items || []);
      }
    } catch (err) {
      console.error('Load menu error:', err);
    }
    setLoading(false);
    setRefreshing(false);
  };

  const handleScan = async (source: 'gallery' | 'camera') => {
    if (source === 'camera') {
      const { status } = await ImagePicker.requestCameraPermissionsAsync();
      if (status !== 'granted') {
        Alert.alert('Permission Needed', 'Camera access is required to scan menus');
        return;
      }
    }

    const result = source === 'gallery'
      ? await ImagePicker.launchImageLibraryAsync({ mediaTypes: ['images'], base64: true, quality: 0.8 })
      : await ImagePicker.launchCameraAsync({ base64: true, quality: 0.8 });

    if (result.canceled || !result.assets?.[0]?.base64) return;

    setScanning(true);
    setScanProgress('Analyzing menu...');
    Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Medium);

    try {
      const token = await getToken();
      if (!token) { Alert.alert('Error', 'Not logged in'); setScanning(false); return; }

      const extractRes = await fetch(`${API_BASE}/api/partner/extract-menu`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({ image_base64: result.assets[0].base64, venue_name: venueName }),
      });

      if (!extractRes.ok) {
        const errText = await extractRes.text();
        console.error('Extract failed:', extractRes.status, errText.slice(0, 200));
        Alert.alert('Scan Failed', 'Could not process the menu image. Try a clearer photo.');
        setScanning(false);
        return;
      }

      const data = await extractRes.json();

      if (!data.items || data.items.length === 0) {
        Alert.alert('No Items Found', 'We couldn\'t find menu items in that photo. Try a clearer, well-lit image.');
        setScanning(false);
        return;
      }

      setScanProgress(`Found ${data.items.length} items, saving...`);

      const saveRes = await fetch(`${API_BASE}/api/partner/save-menu`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({ items: data.items }),
      });

      if (!saveRes.ok) {
        const errText = await saveRes.text();
        console.error('Save failed:', saveRes.status, errText.slice(0, 200));
        Alert.alert('Partial Success', `Found ${data.items.length} items but couldn't save them.`);
        setScanning(false);
        return;
      }

      const saveData = await saveRes.json();
      if (saveData.success) {
        Haptics.notificationAsync(Haptics.NotificationFeedbackType.Success);
        Alert.alert('Menu Updated', `${data.items.length} items added to your menu`);
        loadMenu();
      } else {
        Alert.alert('Error', saveData.error || 'Failed to save items');
      }
    } catch (err: any) {
      console.error('Scan error:', err);
      Alert.alert('Error', 'Menu scan failed: ' + (err?.message || String(err)));
    }
    setScanning(false);
    setScanProgress('');
  };

  const openAddModal = () => {
    setEditingItem(null);
    setItemName('');
    setItemPrice('');
    setItemCategory('Cocktails');
    setModalVisible(true);
    Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);
  };

  const openEditModal = (item: MenuItem) => {
    setEditingItem(item);
    setItemName(item.item_name);
    setItemPrice(item.price > 0 ? item.price.toString() : '');
    setItemCategory(
      ADD_CATEGORIES.find(c => c.toLowerCase() === (item.category || '').toLowerCase()) || 'Other'
    );
    setModalVisible(true);
    Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);
  };

  const handleSaveItem = async () => {
    if (!itemName.trim()) return;
    setSaving(true);
    Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);

    try {
      const token = await getToken();

      if (editingItem) {
        // Delete old item first
        await fetch(`${API_BASE}/api/partner/save-menu`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ item_id: editingItem.id }),
        });
      }

      // Save new/updated item
      const res = await fetch(`${API_BASE}/api/partner/save-menu`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({
          items: [{ item_name: itemName.trim(), price: parseFloat(itemPrice) || 0, category: itemCategory.toLowerCase() }],
        }),
      });
      const data = await res.json();
      if (data.success) {
        Haptics.notificationAsync(Haptics.NotificationFeedbackType.Success);
        setModalVisible(false);
        setEditingItem(null);
        setItemName('');
        setItemPrice('');
        setItemCategory('Cocktails');
        loadMenu();
      } else {
        Alert.alert('Error', data.error || 'Failed to save item');
      }
    } catch (err: any) {
      Alert.alert('Error', err?.message || 'Failed to save item');
    }
    setSaving(false);
  };

  const handleDelete = async (itemId: number) => {
    Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Medium);
    try {
      const token = await getToken();
      await fetch(`${API_BASE}/api/partner/save-menu`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({ item_id: itemId }),
      });
      setItems(prev => prev.filter(i => i.id !== itemId));
    } catch {
      Alert.alert('Error', 'Failed to remove item');
    }
  };

  const filteredItems = activeFilter === 'all'
    ? items
    : items.filter(i => (i.category || 'other').toLowerCase() === activeFilter);
  const groups = groupByCategory(filteredItems);
  const categoryKeys = [...new Set(items.map(i => (i.category || 'other').toLowerCase()))];

  if (loading) {
    return (
      <View style={styles.loadingContainer}>
        <ActivityIndicator size="small" color="#fff" />
      </View>
    );
  }

  return (
    <GestureHandlerRootView style={{ flex: 1 }}>
      <View style={styles.container}>
        <SafeAreaView style={styles.safeArea} edges={['top']}>
          {/* Header */}
          <View style={styles.header}>
            <View>
              <Text style={styles.headerTitle}>Menu</Text>
              <Text style={styles.headerSub}>{items.length} items{venueName ? ` · ${venueName}` : ''}</Text>
            </View>
            <TouchableOpacity style={styles.addButton} onPress={openAddModal}>
              <Ionicons name="add" size={22} color="#fff" />
            </TouchableOpacity>
          </View>

          {/* Scan Section */}
          {scanning ? (
            <Animated.View entering={FadeIn.duration(200)} style={styles.scanningCard}>
              <ActivityIndicator size="small" color="#8b5cf6" />
              <Text style={styles.scanningText}>{scanProgress || 'Analyzing menu...'}</Text>
            </Animated.View>
          ) : (
            <Animated.View entering={FadeInDown.duration(300)} style={styles.scanCard}>
              <View style={styles.scanIconRow}>
                <View style={styles.scanIconBg}>
                  <Ionicons name="scan-outline" size={20} color="#8b5cf6" />
                </View>
                <View style={{ flex: 1 }}>
                  <Text style={styles.scanTitle}>AI Menu Scanner</Text>
                  <Text style={styles.scanDesc}>Snap a photo, we extract every item</Text>
                </View>
              </View>
              <View style={styles.scanButtons}>
                <TouchableOpacity style={styles.scanBtn} onPress={() => handleScan('camera')}>
                  <Ionicons name="camera-outline" size={18} color="#8b5cf6" />
                  <Text style={styles.scanBtnText}>Camera</Text>
                </TouchableOpacity>
                <TouchableOpacity style={styles.scanBtn} onPress={() => handleScan('gallery')}>
                  <Ionicons name="images-outline" size={18} color="#8b5cf6" />
                  <Text style={styles.scanBtnText}>Gallery</Text>
                </TouchableOpacity>
              </View>
            </Animated.View>
          )}

          {/* Category Filter */}
          {items.length > 0 && (
            <ScrollView
              horizontal
              showsHorizontalScrollIndicator={false}
              style={styles.filterScroll}
              contentContainerStyle={styles.filterContent}
            >
              <TouchableOpacity
                style={[styles.filterPill, activeFilter === 'all' && styles.filterPillActive]}
                onPress={() => setActiveFilter('all')}
              >
                <Text style={[styles.filterText, activeFilter === 'all' && styles.filterTextActive]}>
                  All ({items.length})
                </Text>
              </TouchableOpacity>
              {categoryKeys.sort((a, b) => (CATEGORY_META[a]?.order ?? 50) - (CATEGORY_META[b]?.order ?? 50)).map(cat => {
                const meta = CATEGORY_META[cat];
                const count = items.filter(i => (i.category || 'other').toLowerCase() === cat).length;
                return (
                  <TouchableOpacity
                    key={cat}
                    style={[styles.filterPill, activeFilter === cat && styles.filterPillActive]}
                    onPress={() => setActiveFilter(cat)}
                  >
                    <Text style={[styles.filterText, activeFilter === cat && styles.filterTextActive]}>
                      {meta?.label || cat.charAt(0).toUpperCase() + cat.slice(1)} ({count})
                    </Text>
                  </TouchableOpacity>
                );
              })}
            </ScrollView>
          )}

          {/* Menu Items */}
          <ScrollView
            style={styles.scrollView}
            showsVerticalScrollIndicator={false}
            refreshControl={
              <RefreshControl refreshing={refreshing} onRefresh={() => { setRefreshing(true); loadMenu(); }} tintColor="#8b5cf6" />
            }
          >
            {items.length === 0 ? (
              <Animated.View entering={FadeInDown.delay(200).duration(400)} style={styles.emptyState}>
                <View style={styles.emptyIcon}>
                  <Ionicons name="restaurant-outline" size={40} color="#3f3f46" />
                </View>
                <Text style={styles.emptyTitle}>No menu items yet</Text>
                <Text style={styles.emptyDesc}>
                  Scan a photo of your menu or add items manually to get started
                </Text>
              </Animated.View>
            ) : (
              groups.map((group, groupIdx) => (
                <Animated.View
                  key={group.key}
                  entering={FadeInDown.delay(groupIdx * 60).duration(300)}
                  style={styles.categoryGroup}
                >
                  <View style={styles.categoryHeader}>
                    <Ionicons name={group.icon as any} size={16} color="#71717a" />
                    <Text style={styles.categoryLabel}>{group.label}</Text>
                    <Text style={styles.categoryCount}>{group.items.length}</Text>
                  </View>
                  <View style={styles.categoryItems}>
                    {group.items.map((item) => (
                      <MenuItemRow key={item.id} item={item} onDelete={handleDelete} onEdit={openEditModal} />
                    ))}
                  </View>
                </Animated.View>
              ))
            )}

            <View style={{ height: 120 }} />
          </ScrollView>

          {/* Bottom Navigation */}
          <View style={styles.bottomNav}>
            <TouchableOpacity style={styles.navItem} onPress={() => router.push('/partner/dashboard')}>
              <Ionicons name="grid-outline" size={22} color="#52525b" />
              <Text style={styles.navText}>Dashboard</Text>
            </TouchableOpacity>
            <TouchableOpacity style={styles.navItem} onPress={() => router.push('/partner/bookings')}>
              <Ionicons name="calendar-outline" size={22} color="#52525b" />
              <Text style={styles.navText}>Bookings</Text>
            </TouchableOpacity>
            <TouchableOpacity style={styles.navItem}>
              <Ionicons name="restaurant" size={22} color="#fff" />
              <Text style={[styles.navText, styles.navTextActive]}>Menu</Text>
            </TouchableOpacity>
            <TouchableOpacity style={styles.navItem} onPress={() => router.push('/partner/events')}>
              <Ionicons name="sparkles-outline" size={22} color="#52525b" />
              <Text style={styles.navText}>Events</Text>
            </TouchableOpacity>
            <TouchableOpacity style={styles.navItem} onPress={() => router.push('/partner/settings')}>
              <Ionicons name="settings-outline" size={22} color="#52525b" />
              <Text style={styles.navText}>Settings</Text>
            </TouchableOpacity>
          </View>
        </SafeAreaView>

        {/* Add/Edit Item Modal */}
        <Modal visible={modalVisible} animationType="slide" transparent onRequestClose={() => setModalVisible(false)}>
          <View style={styles.modalOverlay}>
            <TouchableOpacity style={styles.modalBackdrop} onPress={() => setModalVisible(false)} />
            <View style={styles.modalContent}>
              <View style={styles.modalHandle} />

              <View style={styles.modalTitleRow}>
                <Text style={styles.modalTitle}>{editingItem ? 'Edit Item' : 'Add Menu Item'}</Text>
                {editingItem && (
                  <TouchableOpacity
                    onPress={() => {
                      Alert.alert('Delete Item', `Remove "${editingItem.item_name}"?`, [
                        { text: 'Cancel', style: 'cancel' },
                        {
                          text: 'Delete',
                          style: 'destructive',
                          onPress: () => {
                            handleDelete(editingItem.id);
                            setModalVisible(false);
                            setEditingItem(null);
                          },
                        },
                      ]);
                    }}
                  >
                    <Ionicons name="trash-outline" size={20} color="#dc2626" />
                  </TouchableOpacity>
                )}
              </View>

              <View style={styles.inputGroup}>
                <Text style={styles.inputLabel}>ITEM NAME</Text>
                <TextInput
                  style={styles.input}
                  placeholder="e.g., Spicy Margarita"
                  placeholderTextColor="#52525b"
                  value={itemName}
                  onChangeText={setItemName}
                  autoFocus={!editingItem}
                />
              </View>

              <View style={styles.inputGroup}>
                <Text style={styles.inputLabel}>PRICE</Text>
                <TextInput
                  style={styles.input}
                  placeholder="$0"
                  placeholderTextColor="#52525b"
                  value={itemPrice}
                  onChangeText={setItemPrice}
                  keyboardType="decimal-pad"
                />
              </View>

              <View style={styles.inputGroup}>
                <Text style={styles.inputLabel}>CATEGORY</Text>
                <ScrollView horizontal showsHorizontalScrollIndicator={false} style={{ marginTop: 8 }}>
                  {ADD_CATEGORIES.map(cat => (
                    <TouchableOpacity
                      key={cat}
                      style={[styles.catPill, itemCategory === cat && styles.catPillActive]}
                      onPress={() => {
                        Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);
                        setItemCategory(cat);
                      }}
                    >
                      <Text style={[styles.catPillText, itemCategory === cat && styles.catPillTextActive]}>
                        {cat}
                      </Text>
                    </TouchableOpacity>
                  ))}
                </ScrollView>
              </View>

              <TouchableOpacity
                style={[styles.modalButton, (!itemName.trim() || saving) && styles.modalButtonDisabled]}
                onPress={handleSaveItem}
                disabled={!itemName.trim() || saving}
              >
                {saving ? (
                  <ActivityIndicator size="small" color="#fff" />
                ) : (
                  <Text style={styles.modalButtonText}>{editingItem ? 'Save Changes' : 'Add Item'}</Text>
                )}
              </TouchableOpacity>
            </View>
          </View>
        </Modal>
      </View>
    </GestureHandlerRootView>
  );
}

